PASTER_VERSION=latest
SIXPASTER_SERVER_LISTEN=:8080
SIXPASTER_SERVER_PUBLIC_URL=https://paste.example.com
SIXPASTER_SERVER_BASE_PATH=/
SIXPASTER_SERVER_REQUIRE_HTTPS=true
SIXPASTER_SERVER_PAGE_TITLE=6paster
# Set to the source CIDR seen by the container for the host proxy.
SIXPASTER_SERVER_TRUSTED_PROXIES=
SIXPASTER_DATABASE_DRIVER=sqlite
SIXPASTER_DATABASE_SQLITE_PATH=/var/lib/6paster/pastes.db
SIXPASTER_PASTE_MINIMUM_TTL=1h
SIXPASTER_PASTE_MAXIMUM_TTL=720h
SIXPASTER_PASTE_MAXIMUM_BYTES=307200
SIXPASTER_PASTE_ALLOW_IMAGES=true
SIXPASTER_RATE_LIMIT_PER_HOUR=60
SIXPASTER_RATE_LIMIT_PER_DAY=100
SIXPASTER_CLEANUP_INTERVAL=1h
